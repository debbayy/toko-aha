# Koneksi PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tokoku"

# Secret untuk Auth.js — buat dengan: npx auth secret  (atau: openssl rand -base64 32)
AUTH_SECRET=""
# Wajib di production jika di belakang proxy/hosting selain Vercel
AUTH_TRUST_HOST=true

# Nama toko & ongkir
NEXT_PUBLIC_STORE_NAME="Dropsip"
SHIPPING_FLAT_RATE=15000
FREE_SHIPPING_MIN=300000

# Akun admin awal yang dibuat oleh `npm run db:seed`
SEED_ADMIN_EMAIL="admin@toko.test"
SEED_ADMIN_PASSWORD="ganti-password-ini"
